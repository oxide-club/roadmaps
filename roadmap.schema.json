{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "summary", "question", "audience", "prerequisites", "learningGoals", "draft", "order", "nodes", "edges"],
  "properties": {
    "version": {"const": 1},
    "title": {"$ref": "#/definitions/text"},
    "summary": {"$ref": "#/definitions/text"},
    "question": {"$ref": "#/definitions/text"},
    "audience": {"$ref": "#/definitions/text"},
    "prerequisites": {"type": "array", "items": {"$ref": "#/definitions/text"}, "uniqueItems": true},
    "learningGoals": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}, "uniqueItems": true},
    "draft": {"type": "boolean"},
    "publishedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "order": {"type": "integer", "minimum": 0},
    "featured": {"type": "boolean"},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref"],
        "properties": {
          "ref": {"$ref": "#/definitions/ref"},
          "context": {"$ref": "#/definitions/text"},
          "relatedRoadmap": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "type"],
        "properties": {
          "from": {"$ref": "#/definitions/ref"},
          "to": {"$ref": "#/definitions/ref"},
          "type": {"enum": ["recommended_next", "suggested_preparation", "branch", "convergence"]},
          "label": {"$ref": "#/definitions/text"}
        }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "primaryPath": {"$ref": "#/definitions/refs"},
        "branchOrder": {"$ref": "#/definitions/refs"}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "nodes"],
        "properties": {"title": {"$ref": "#/definitions/text"}, "nodes": {"$ref": "#/definitions/refs"}}
      }
    }
  },
  "allOf": [{"if": {"properties": {"draft": {"const": false}}}, "then": {"required": ["publishedAt"]}}],
  "definitions": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ref": {"type": "string", "pattern": "^(?:(?:challenges|labs):[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*|notes:(?!(?:templates|docs|scripts|tests)$)[a-z0-9]+(?:-[a-z0-9]+)*)$"},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/ref"}}
  }
}
